PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Keep this key in backend/.env only. Never put it in frontend/.env.
GROQ_API_KEY=
# Groq model used for manga logic and image-prompt creation.
GROQ_WRITER_MODEL=openai/gpt-oss-120b
# Gemini is used only to render the finished page images.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
